!///////////////////////////////////////////////////////////////////////////////////////
!// ecev3 guess.ins

! optimesm & rescue
import "ecearth.ins"
! import "global.ins"
import "crop_n.ins"
import "landuse.ins"

param "file_gridlist"        (str "../ece_gridlist_TCO95.txt")

! *** SIMFIRE/BLAZE fire input
! EC-Earth coupling uses NetCDF files in work/fire/ directory (hardcoded in simfire_input.cpp)
! This param is required but ignored - actual files are: simfire_monthly_ba.nc, annual_population_density.nc
param "file_simfire"  (str "dummy")

! Fire model selection: BLAZE, GLOBFIRM, NOFIRE
firemodel "BLAZE"

! optimesm
import "wetlandpfts.ins"

!///////////////////////////////////////////////////////////////////////////////////////
!// RUN PARAMETERS AND OPTIONS 

! ecev3 - overrides ifbvoc 0 in global.ins
ifbvoc 1

! AWI-ESM3 - override spinup parameters from ecearth.ins
! nyear_spinup must be > freenyears to avoid fatal error
! Default: nyear_spinup=500, freenyears=100 (matching vendor branch)
nyear_spinup 1
freenyears 0

! ecev3 - set to 1
ifintercropgrass 1	! Whether to grow grass as cover crop between growing periods


!///////////////////////////////////////////////////////////////////////////////////////
!// ecev3 - Parameters and options specific to LPJ-GUESS coupled to EC-Earth

! N deposition (blank string to use constant pre-industrial level of 2 kgN/ha/year)
! NB! not used in EC-Earth coupling
!param "file_ndep"     (str "c:/ndep/GlobalNitrogenDeposition.bin")
param "file_ndep"     (str "") ! NB! MUST be cru_ncep version of this file

! CMIP N deposition - replaces file_ndep
! param "ndep_cmip_dir" (str "../ndep/") 
param "ndep_cmip_dir" (str "../ndep/")
! if (param["ndep_cmip_dir"].str != "") { // PaulM - ECE4 hack - option to run without ndep
! PaulM - ECE4 hack - edited 

! CMIP CO2 forcing file (set by choose_mip block based on mip version)
param "file_co2" (str "co2_input4MIPs_GHGConcentrations_CMIP_CR-CMIP-1-0-0_gm_1750-2022.nc")

! Whether to use soil water content and soil temperature sent from IFS (1), or use GUESS' own
! hydrology (driven by precipitation) and analytic soil temperature (0).
param "useifssoilmoist" (num 0)
param "useifssoiltemp" (num 1)


! Determine which RCP to use
! 0 - historical only (i.e. use file_co2 below)
! 1 - use ghg_rcp3PD.txt
! 2 - use ghg_rcp45.txt
! 3 - use ghg_rcp60.txt
! 4 - use ghg_rcp85.txt
param "nrcp" (num 0)

! State file name and directory 
! For saving and reading .bin files.
!state_path "./" 
param "state_path" (str "../") 	! directory containing the .bin state files
param "state_name" (str "lpjg")	! state filenames
param "restart" (num 1) ! 		! 1: restart from .bin files. 0: start from bare ground
! PaulM ECE4 hack - changed to 0

! Number of years in IFS spinup forcing file (must match the forcing NetCDF time dimension)
param "nyearifs" (num 10)

! Paths to IFS spinup data - MUST have trailing "/" (linux/unix systems) or "\" (Windows)

! NSC ECE 3p1:
!param "spinup_directory" (str "/nobackup/rossby15/sm_paumi/ecev3/processed/daily/")
! NSC ECE 3p2 AMIP output:
!param "spinup_directory" (str "/nobackup/rossby18/sm_wyser/ecearth3-amip/processed/daily/")
! Fast AMIP output:
!param "spinup_directory" (str "/nobackup/rossby20/sm_paumi/amipspinupforcing/")
! lsm runscript: ifs_spinup_forcing must be linked in the runtime script
param "spinup_directory" (str "../ifs_spinup_forcing/")

! Tetralith, GSWP files:
! param "spinup_directory" (str "/proj/rescue/lpjg/gswp3/osm_forcing/gswp3/T255L91/lpjg_spinup_forcing/")

!param "spinup_directory" (str "D:\DATA\J\EC-Earth\Version3p1_output\se21\daily\") ! Older set
!param "spinup_directory" (str "D:\DATA\J\EC-Earth\Version3p2_output\AMIP\") 

! N deposition (default is pre-industrial level of 2 kgN/ha/year)
param "ndep" (num 2)

! Print Lon/Lat with extra precision. Default is 1
coordinates_precision 6


! optimesm & rescue TESTING
! PaulM ECE4 hack - changed below
npatch 5                                ! number of replicate patches to simulate (ecearth.ins value: 15)

! LUH3 NetCDF land use input (0 = use text files, 1 = use NetCDF LUH3 files)
use_luh3_input 1

file_luh3_states "/work/ab0246/a270092/input//lpj-guess//land_use/TCO95/multiple-states_input4MIPs_landState_CMIP_UofMD-landState-3-1-2_gn_0850-2024_TCO95.nc"
file_luh3_management "/work/ab0246/a270092/input//lpj-guess//land_use/TCO95/multiple-management_input4MIPs_landState_CMIP_UofMD-landState-3-1-2_gn_0850-2024_TCO95.nc"

! Audited cells allowed to be NATURAL=1 where all 12 LUH3 states are fill (4.1.11 refuses
! to substitute otherwise): coastline-gridlist cells LUH3 never covered (lakes, islands).
file_luh3_natural_override "/work/ab0246/a270092/input//lpj-guess//land_use/TCO95/luh3_natural_override_TCO95_CORE3.txt"


! Single transition file mode
file_luh3_transitions "/work/ab0246/a270092/input//lpj-guess//land_use/TCO95/multiple-transitions_input4MIPs_landState_CMIP_UofMD-landState-3-1-2_gn_0850-2023_TCO95.nc"

! Override LUH2 text files to empty strings when using LUH3 NetCDF
param "file_lu" (str "")
param "file_lucrop" (str "")
param "file_Nfert" (str "")
param "file_grossLUC" (str "")


run_landcover 1        ! whether to use (and change) landcover fractions (1) or not (0)

run_urban 1           ! whether to simulate urban land (1) or not (0)
run_crop 1            ! whether to simulate crop vegetation (1) or not (0)
run_forest 0          ! whether to simulate managed forest (1) or not (0)
run_pasture 1         ! whether to simulate pasture (1) or not (0)
run_natural 1         ! whether to simulate natural vegetation (1) or not (0)
run_peatland 1        ! whether to simulate peatland (1) or not (0)
run_barren 0          ! whether to simulate barren land (1) or not (0)

! Peatland fraction input file (only used when run_peatland = 1)

param "file_peat" (str "../landuse/peat_frac.txt")


!printcmip 0            ! Whether to print CMIP output
!printcmipdaily 0       ! Whether to print daily CMIP output

ifmethane 1
